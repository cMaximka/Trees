{% extends "__layout.twig" %}

{% block content %}
    {% if isEdit %}
    <h1>Редактирование</h1>
    <hr>
    {% else %}
    <h1>Добавление Растения</h1>
    <hr>
    {% endif %}
    


    {% if message %}
    <div class ="alert alert-info">
        {{ message }}
        <a href="/trees/{{ id }}">Открыть обьект</a>
    </div>
    {% endif %}
    

    <form action="" enctype="multipart/form-data" method="POST" class="row g-3">
        <div class="col-4">
            <label class="form-label">Название</label>
            <input type="text" class="form-control" name="title" value="{{object.title}}">
        </div>
        <div class="col-4">
            <label class="form-label">Краткое описание</label>
            <input type="text" class="form-control" name="description" value="{{object.des}}">
        </div>
        <div class="col-4">
            <label class="form-label">Тип</label>
            <select class="form-control" name="type">
                {% for type in types %}
                    <option value="{{type.id}}" {% if type.id == object.type %}selected{% endif %}> 
                        {{type.title|title}} 
                    </option>
                {% endfor %}

            </select>
        </div>
        <div class="mb-3">
            <label class="form-label"Картинка></label>
            <input class="form-control" type="file" name="image">
        </div>
        <div class="col-12">
            <textarea name="info" placeholder="Полное описание..." class="form-control" rows="5">{{ object.info }}</textarea>
        </div>
        <div class="col-12 text-end">
            {% if isEdit %}
            <button type="submit" class="btn btn-primary">Редактировавние</button>
            {% else %}
            <button type="submit" class="btn btn-primary">Добавить</button>
            {% endif %}
        </div>
    </form>

{% endblock %}
{% extends "__layout.twig" %}

{% import 'macros.twig' as macros %}

{% block content %}

Сообщение из сессии: {{my_session_message}}
<br>
Последние сообщения: <br>
{% for m in messages %}
    {% if m %}
    {{m}}<br>
    {% endif %}
{% endfor %}

<h1>{{ description }}</h1>
<ul class="nav nav-pills">
  <li class="nav-item">
    {{ macros.btn("Картинка", "/trees/" ~ id ~ "?show=image", is_image, 'primary') }}
  </li>
  <li class="nav-item">
    {{ macros.btn("Описание", "/trees/" ~ id ~ "?show=info", is_info, 'primary') }}
  </li>
</ul>
<div>
    <ul class="list-group my-2">
        <li class="list-group-item">
            {% block objectContent %} 
            <p>Выберите «Картинка» или «Описание»</p>
            {% endblock %}
        </li>
    </ul>
</div>
{% endblock %}
<!DOCTYPE html>
<html lang="en">
 <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="/style.css" rel="stylesheet">
  </head>
<body>
    {% import 'macros.twig' as macros %}
    <nav class="navbar navbar-expand-lg bg-light">
  <div class="container">
    <a class="navbar-brand" href="#"><i class="fas fa-meteor"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Главная</a>
        </li>
        {% for type in types %}
            <li class="nav-item">
                <a class="nav-link" href="/?type={{ type.title }}">{{ type.title|title }}</a>
            </li>
        {% endfor %}
        <li class="nav-item">
            <a class="nav-link" aria-current="page" href="/search">Поиск</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" aria-current="page" href="/add">Добавить обьект</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" aria-current="page" href="/createType">Добавить тип</a>
        </li>
        <form action="/set-welcome/">
            <input type = "text" name = "message" class = "form-control mr-2 ml-2">
        </form>
      </ul>
      <form action="/logout" method="post" class = "ms-auto">
        <button type="submit" class="btn btn-primary">Выход</button>
      </form>
    </div>
  </div>
</nav>
<div class="container mt-4">
    <div class="row">
        <div class="col-md-9">
            {% block content %}
            {% endblock %}
        </div>
        
        <ul class="list-group col-md-3">
            <h5>Последние страницы:</h5>
            {% for url in history|reverse %}
                <li class="list-group-item">
                  <a href="{{ url }}">{{ url }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
</div>
</body>
</html>